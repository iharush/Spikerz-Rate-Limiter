{
  "name": "spikerz-rate-limiter",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:server && npm run build -w @spikerz/admin-web",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && npm run typecheck -w @spikerz/admin-web",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit --runInBand",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration --runInBand",
    "test:all": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "start": "docker compose up --build -d --wait",
    "stop": "docker compose down",
    "dev:web": "npm run dev -w @spikerz/admin-web",
    "demo:seed": "node --env-file-if-exists=.env scripts/seed-demo.mjs",
    "package": "node scripts/package.mjs",
    "format": "prettier --write apps packages tests scripts *.json *.cjs docker-compose.yml infra/compose.test.yml README.md",
    "format:check": "prettier --check apps packages tests scripts *.json *.cjs docker-compose.yml infra/compose.test.yml README.md"
  },
  "dependencies": {
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "@nestjs/platform-socket.io": "12.3.3",
    "@nestjs/websockets": "12.3.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.3",
    "@swc/core": "^1.13.5",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "jest": "30.5.2",
    "jest-mock-extended": "4.0.2",
    "prettier": "3.9.10",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4",
    "typescript": "6.0.3"
  },
  "type": "module"
}
