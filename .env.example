# Copy to .env and set your own DEMO_PASSWORD before starting the demo.
# Keep .env out of Git. Use URL-safe characters in database passwords.
DEMO_PASSWORD=
INTERNAL_SERVICE_KEY=local-development-service-key-change-me-123456789
DATA_DB_PASSWORD=local-data-password
CONTROL_DB_PASSWORD=local-control-password
MANAGEMENT_DB_PASSWORD=local-management-password
